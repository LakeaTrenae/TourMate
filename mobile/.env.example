# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# The EXPO_PUBLIC_ prefix means these get bundled directly into the app
# binary at build time and are readable by anyone who inspects the app.
# That's fine for the Supabase URL + anon key — they're DESIGNED to be
# public; actual data access is enforced by Postgres Row-Level Security
# (see supabase/migrations/0001_init.sql), not by keeping this key secret.
#
# NEVER put the Supabase `service_role` key here, or anywhere in this app.
# It bypasses every RLS policy and must only ever live in a trusted
# server-side environment.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key